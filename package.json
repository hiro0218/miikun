{
  "name": "miikun",
  "version": "3.2.1",
  "private": true,
  "description": "A Simple Markdown Editor",
  "author": "hiro <hiro0218@gmail.com>",
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "prebuild": "electron-vite build",
    "electron:build": "npm run prebuild && electron-builder --mac zip",
    "electron:serve": "electron-vite dev",
    "format:scss": "stylelint --fix \"src/**/*.scss\"",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "husky"
  },
  "main": "./out/main/background.js",
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/view": "^6.43.1",
    "@electron/remote": "^2.1.3",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "debounce": "^3.0.0",
    "markdown-it": "^14.2.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-checkbox": "^1.1.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "normalize.css": "^8.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "stylelint": "^17.13.0",
    "stylelint-config-property-sort-order-smacss": "^11.2.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.5"
  },
  "bugs": {
    "url": "https://github.com/hiro0218/Miikun/issues"
  },
  "homepage": "https://github.com/hiro0218/Miikun#readme",
  "license": "MIT",
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "productName": "miikun",
  "build": {
    "appId": "jp.0218.miikun",
    "mac": {
      "target": [
        "zip"
      ]
    },
    "files": [
      "out/**/*",
      "package.json"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiro0218/Miikun.git"
  }
}
